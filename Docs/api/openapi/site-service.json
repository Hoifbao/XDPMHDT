{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Heritage - site-service",
    "description": "Di tích và tìm di tích gần vị trí (Haversine). Client gọi qua Gateway http://localhost:8080; API cần đăng nhập đọc người dùng từ header X-User-* do Gateway gắn.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "API Gateway (8080): kiểm tra JWT và phân quyền như Web/Mobile"
    }
  ],
  "tags": [
    {
      "name": "2. Di tích",
      "description": "CRUD di tích, tìm di tích gần (Ân)"
    }
  ],
  "paths": {
    "/api/heritage-sites/{id}": {
      "get": {
        "tags": [
          "2. Di tích"
        ],
        "summary": "Chi tiết di tích",
        "description": "Không tồn tại trả 404 (content/beacon-service dùng để kiểm tra siteId)",
        "operationId": "getById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHeritageSiteResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "2. Di tích"
        ],
        "summary": "Sửa di tích",
        "description": "Cập nhật một phần: bỏ trống trường nào thì giữ nguyên; clearCoordinates = true để xóa tọa độ",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeritageSiteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHeritageSiteResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "2. Di tích"
        ],
        "summary": "Xóa di tích",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/heritage-sites": {
      "get": {
        "tags": [
          "2. Di tích"
        ],
        "summary": "Danh sách di tích",
        "operationId": "getAll",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListHeritageSiteResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "2. Di tích"
        ],
        "summary": "Thêm di tích",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeritageSiteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHeritageSiteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/heritage-sites/nearby": {
      "get": {
        "tags": [
          "2. Di tích"
        ],
        "summary": "Di tích gần vị trí (Haversine)",
        "description": "Sắp gần → xa; radius km, mặc định 5, tối đa 50; tọa độ sai trả 400",
        "operationId": "getNearby",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 5.0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListNearbyHeritageSiteResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HeritageSiteRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "mapImageUrl": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "clearCoordinates": {
            "type": "boolean"
          }
        }
      },
      "ApiResponseHeritageSiteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/HeritageSiteResponse"
          }
        }
      },
      "HeritageSiteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "mapImageUrl": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        }
      },
      "ApiResponseListHeritageSiteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HeritageSiteResponse"
            }
          }
        }
      },
      "ApiResponseListNearbyHeritageSiteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NearbyHeritageSiteResponse"
            }
          }
        }
      },
      "NearbyHeritageSiteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "mapImageUrl": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Dán accessToken lấy từ POST /api/auth/login (không gõ chữ Bearer)"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
