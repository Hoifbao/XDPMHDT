# Spring Boot reads these when they are exported as environment variables.
# A .env file is not loaded automatically by Spring Boot.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/smart_heritage_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-local-secret
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379