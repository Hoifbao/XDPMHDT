# Biến môi trường cho docker compose (Bảo - Sprint 4).
# Copy file này thành Infra/.env rồi sửa giá trị. File .env KHÔNG commit (đã có trong .gitignore).
# Không có .env thì compose dùng giá trị mặc định (chỉ dành cho máy dev).

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword123

# JWT: Gateway, auth-service và Backend cũ PHẢI dùng chung khóa này (tối thiểu 32 ký tự)
JWT_SECRET=smart-heritage-dev-secret-key-change-me-0123456789abcdef

# RabbitMQ (profile mq): giao diện http://localhost:15672
RABBITMQ_USER=smartheritage
RABBITMQ_PASSWORD=change-me-rabbit

# Grafana (profile monitoring): http://localhost:3000, tài khoản admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# NiFi (profile nifi): https://localhost:8443/nifi, mật khẩu tối thiểu 12 ký tự
NIFI_USERNAME=admin
NIFI_PASSWORD=change-me-nifi-123
