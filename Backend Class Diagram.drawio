        <mxCell id="clients" value="&lt;div style=&quot;font-size:16px;font-weight:bold;text-align:center&quot;&gt;CLIENT APPLICATIONS&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;text-align:left&quot;&gt;&lt;b&gt;Visitor Mobile App&lt;/b&gt;&lt;br/&gt;• Login / profile&lt;br/&gt;• BLE / iBeacon detection&lt;br/&gt;• Artifact content &amp;amp; audio&lt;br/&gt;• Favorites / visit history&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Web Admin&lt;/b&gt;&lt;br/&gt;• Manage sites, artifacts, beacons&lt;br/&gt;• Moderation &amp;amp; reports&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
