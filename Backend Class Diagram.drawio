        <mxCell id="security-overview" value="&lt;div style=&quot;font-size:16px;font-weight:bold;text-align:center&quot;&gt;CROSS-CUTTING SECURITY&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:14px;text-align:left&quot;&gt;SecurityConfig · Spring Security&lt;br/&gt;JwtAuthenticationFilter · JwtService&lt;br/&gt;CustomUserDetailsService&lt;br/&gt;PasswordEncoder · GlobalExceptionHandler&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="235" y="575" width="1190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="overview-note-new" value="&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;Luồng tổng quát: Mobile/Web → REST Controllers → Services → Spring Data JPA Repositories → JPA Entities/Database. Spring Security bảo vệ các endpoint và áp dụng phân quyền. iBeacon được quét ở ứng dụng di động; Backend ánh xạ beacon sang nội dung và ghi nhận tương tác.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#334155;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="235" y="725" width="1190" height="78" as="geometry" />
        </mxCell>
